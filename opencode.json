{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "gortex": {
      "type": "local",
      "command": ["gortex", "mcp"],
      "enabled": true,
      "environment": {
        "GORTEX_INDEX_WORKERS": "8"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    }
  }
}
