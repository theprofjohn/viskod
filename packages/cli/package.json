{
  "name": "@viskod/cli",
  "version": "0.2.2-alpha",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "viskod": "./dist/index.js"
  },
  "files": ["dist/index.js"],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "node ../../scripts/build-cli.mjs",
    "postinstall": "playwright install chromium"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "playwright": "^1.46.0"
  },
  "devDependencies": {
    "@viskod/shared": "workspace:*",
    "@viskod/event-bus": "workspace:*",
    "@viskod/browser-runtime": "workspace:*",
    "@viskod/capture-pipeline": "workspace:*",
    "@viskod/context-engine": "workspace:*",
    "@viskod/selection-engine": "workspace:*",
    "@viskod/project-scanner": "workspace:*",
    "@viskod/source-hint-engine": "workspace:*",
    "@viskod/mcp-server": "workspace:*",
    "@viskod/config": "workspace:*",
    "@viskod/runtime-session": "workspace:*"
  }
}
