{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {}
  },
  "references": [
    { "path": "./packages/shared" },
    { "path": "./packages/event-bus" },
    { "path": "./packages/config" },
    { "path": "./packages/browser-runtime" },
    { "path": "./packages/capture-pipeline" },
    { "path": "./packages/overlay-system" },
    { "path": "./packages/context-engine" },
    { "path": "./packages/selection-engine" },
    { "path": "./packages/project-scanner" },
    { "path": "./packages/source-hint-engine" },
    { "path": "./packages/mcp-server" },
    { "path": "./packages/cli" },
    { "path": "./packages/diagnostics" },
    { "path": "./packages/sdk" },
    { "path": "./packages/plugin-system" },
    { "path": "./packages/permissions" },
    { "path": "./packages/audit" },
    { "path": "./packages/workspace" },
    { "path": "./packages/runtime-session" },
    { "path": "./packages/visual-selection" },
    { "path": "./packages/visual-issue" },
    { "path": "./packages/agent-handoff" },
    { "path": "./packages/visual-review" },
    { "path": "./apps/studio" }
  ],
  "exclude": ["examples/dogfood-app"]
}
