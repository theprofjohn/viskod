# IDE / local tooling
.gemini/
.hermes/
.claude/
.cursor/
.vscode/
.opencode/
opencode.json
.viskod/
.viskod-test-*
.viskod-mcp-e2e/

# Dependencies
node_modules/

# Config files

# Generated files
*.tsbuildinfo
*.js.map
*.d.ts.map
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
apps/*/src/**/*.js
apps/*/src/**/*.d.ts
**/dist
**/coverage

# Root compiled config
/*.js
/*.d.ts
/*.js.map
/*.d.ts.map

# Test artifacts
tests/**/*.js
tests/**/*.d.ts
tests/**/*.js.map
tests/**/*.d.ts.map

# Vite config cache (written next to vite.config.ts on dev-server boot;
# nested gitignore alone is not honored by biome — VISKOD-AUDIT-018)
**/vite.config.ts.timestamp-*.mjs

# pnpm temp files
pnpm-lock.yaml.*

# Runtime captures and logs
.viskod/captures/
.viskid/session.json
.viskod/*.tmp
.viskod/logs/
.viskod-test-mcp-handoff/

# Environment files — never commit real values
.env
.env.*
!.env.example

# Internal harness and evidence artifacts (not part of the public core)
.omp/
phase21-dogfood-evidence/
reports/
specs/P0_*
specs/VERTICAL_SLICE_*
specs/ACCEPTANCE_GATES*
specs/PROGRAMME_REPORT*
.viskod-dogfood-*

# Dogfood fixture emitted artifacts (root tsc project must not compile it)
examples/dogfood-app/src/**/*.js
examples/dogfood-app/src/**/*.d.ts
examples/dogfood-app/src/**/*.js.map
examples/dogfood-app/src/**/*.d.ts.map

# Dogfood fixture emitted artifacts (root tsc project must not compile it)
examples/dogfood-app/**/*.js
examples/dogfood-app/**/*.d.ts
examples/dogfood-app/**/*.js.map
examples/dogfood-app/**/*.d.ts.map

# Dogfood test output evidence (regenerated on every run)
phase21-dogfood-evidence/

# OS noise
.DS_Store
Thumbs.db
*.swp

# Windows NTFS alternate-data-stream markers (from copying off NTFS drives)
*.Zone.Identifier

# Worktrees
.worktrees/
